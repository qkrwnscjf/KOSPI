  // 시험은 src 파일을 `.ts` 확장자로 직접 가져오므로(node 실행 방식) allowImportingTsExtensions를 켠다. Node 내장 모듈 선언은 test/node-test.d.ts
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
